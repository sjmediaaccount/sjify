# ==============================================================================
# SJify Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=sjify_development_super_secret_key_change_in_production_1234567890
JWT_EXPIRES_IN=7d
COOKIE_SECRET=sjify_cookie_secret_key_9876543210

# Database (PostgreSQL)
DATABASE_URL=postgresql://sjify_user:sjify_secure_password@localhost:5432/sjify_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-compatible Object Storage)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sjify_minio_admin
S3_SECRET_KEY=sjify_minio_password
S3_BUCKET_DATASETS=sjify-datasets
S3_BUCKET_KEYVALUE=sjify-keyvalue
S3_BUCKET_LOGS=sjify-logs
S3_BUCKET_BUILDS=sjify-builds
S3_FORCE_PATH_STYLE=true

# Docker Engine Runner (Windows default named pipe: //./pipe/docker_engine, Linux: /var/run/docker.sock)
DOCKER_SOCKET_PATH=//./pipe/docker_engine
DOCKER_HOST_TCP=

# Stripe Billing (Test mode keys)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_for_dev
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_pub_key
